# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/

# Gagnagrunnur
DATABASE_URL=postgres://jolahjol:jolahjol@127.0.0.1:5433/jolahjol
DB_CONN_MAX_AGE=60

# Póstur (console í þróun)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Jólahjól <noreply@localhost>

# Öryggi (sett í prod á bak við Cloudflare)
SECURE_PROXY_SSL_HEADER=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Sentry (virkt aðeins ef sett)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Google-innskráning (valfrjálst; hnappurinn birtist aðeins ef þetta er sett)
# Redirect URI í Google Cloud: https://<lén>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
