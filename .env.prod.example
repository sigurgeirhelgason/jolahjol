# .env á þjóninum (~/jolahjol/.env). Afritaðu þessa skrá þangað og fylltu út.
# Aldrei í git.

# ---------- Leyndarmál (búa til nýtt fyrir prod) ----------
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Aðeins bókstafir og tölur (fer inn í DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Cloudflare → Zero Trust → Networks → Tunnels → jolahjol → token
CLOUDFLARE_TUNNEL_TOKEN=
# Leynileg slóð á admin, t.d. stjorn-8f3k2/ (endar á /)
DJANGO_ADMIN_URL=

# ---------- Lén ----------
CANONICAL_HOST=jolahjol.is
# localhost fyrir docker healthcheck; punktur fremst nær líka yfir www.
ALLOWED_HOSTS=jolahjol.is,.jolahjol.is,.xn--jlahjl-bxae.is,localhost
CSRF_TRUSTED_ORIGINS=https://jolahjol.is
SITE_URL=https://jolahjol.is

# ---------- Öryggi á bak við Cloudflare ----------
DEBUG=False
SECURE_PROXY_SSL_HEADER=1
SECURE_SSL_REDIRECT=True
# Byrja á 1 klst.; hækka í 31536000 (1 ár) þegar allt virkar
SECURE_HSTS_SECONDS=3600
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
RATELIMIT_IP_META_KEY=HTTP_CF_CONNECTING_IP
ALLAUTH_TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# ---------- Póstur: Gmail SMTP ----------
# App-lykilorð: myaccount.google.com/apppasswords (krefst 2FA). Hámark 500 póstar á dag.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Verður að vera Gmail-netfangið (eða alias skráð í Gmail), annars breytir Gmail því
DEFAULT_FROM_EMAIL=Jólahjól <netfang@gmail.com>

# ---------- Sentry ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------- Gunicorn (þjónninn er deildur, 2 ferlar duga) ----------
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# ---------- Google-innskráning (valfrjálst) ----------
# Redirect URI: https://jolahjol.is/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
